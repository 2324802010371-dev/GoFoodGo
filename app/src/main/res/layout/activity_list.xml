<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
 android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/cream" android:padding="18dp">
 <TextView android:id="@+id/txtTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Giỏ hàng 🛒" android:textColor="@color/ink" android:textSize="26sp" android:textStyle="bold" android:layout_marginBottom="16dp"/>
 <TextView android:id="@+id/txtEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Hiện chưa có dữ liệu" android:textColor="@color/muted" android:gravity="center" android:padding="18dp" android:visibility="gone"/>
 <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
 <TextView android:id="@+id/txtTotal" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tổng: 0đ" android:textColor="@color/coral" android:textSize="20sp" android:textStyle="bold" android:gravity="end" android:padding="12dp"/>
 <com.google.android.material.button.MaterialButton android:id="@+id/btnAction" android:layout_width="match_parent" android:layout_height="54dp" android:text="TIẾP TỤC" app:cornerRadius="16dp" app:backgroundTint="@color/coral" />
</LinearLayout>
