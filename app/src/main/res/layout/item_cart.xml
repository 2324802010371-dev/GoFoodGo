<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_round" android:padding="12dp" android:layout_marginBottom="10dp" android:gravity="center_vertical" android:orientation="horizontal">
 <ImageView android:id="@+id/imgFood" android:layout_width="82dp" android:layout_height="82dp" android:background="@drawable/bg_pale" android:scaleType="centerCrop" android:contentDescription="Ảnh món"/>
 <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="12dp" android:orientation="vertical">
 <TextView android:id="@+id/txtName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tên món" android:textStyle="bold" android:textColor="@color/ink" android:textSize="15sp"/>
 <TextView android:id="@+id/txtPrice" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0đ" android:textColor="@color/coral" android:textStyle="bold" android:layout_marginTop="3dp"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="7dp" android:orientation="horizontal">
   <TextView android:id="@+id/btnMinus" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:text="−" android:textColor="@color/coral" android:textSize="24sp" android:background="@drawable/bg_pale"/>
   <TextView android:id="@+id/txtQuantity" android:layout_width="44dp" android:layout_height="wrap_content" android:text="1" android:gravity="center" android:textColor="@color/ink" android:textStyle="bold"/>
   <TextView android:id="@+id/btnPlus" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:text="+" android:textColor="@color/coral" android:textSize="23sp" android:background="@drawable/bg_pale"/>
 </LinearLayout>
 </LinearLayout>
</LinearLayout>
