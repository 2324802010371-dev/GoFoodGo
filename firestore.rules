rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['uid','name','email','avatarUrl','createdAt'])
        && request.resource.data.keys().hasOnly(['uid','name','email','avatarUrl','createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','avatarUrl'])
        && request.resource.data.name is string
        && request.resource.data.avatarUrl is string;
      allow delete: if false;
    }
    match /foods/{foodId} {
      allow get, list: if signedIn() && (resource.data.active == true || isAdmin());
      allow create: if isAdmin() && validFood();
      allow update: if isAdmin() && validFood();
      allow delete: if isAdmin();
      function validFood() {
        return request.resource.data.keys().hasAll(['name','description','category','price','imageUrl','active','createdAt'])
          && request.resource.data.keys().hasOnly(['name','description','category','price','imageUrl','active','createdAt'])
          && request.resource.data.name is string
          && request.resource.data.description is string
          && request.resource.data.category is string
          && request.resource.data.imageUrl is string
          && request.resource.data.price is int
          && request.resource.data.price >= 1000
          && request.resource.data.price <= 10000000
          && request.resource.data.active is bool;
      }
    }
    match /orders/{orderId} {
      allow get, list: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['uid','items','total','status','phone','address','createdAt'])
        && request.resource.data.keys().hasOnly(['uid','items','total','status','phone','address','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.total is int
        && request.resource.data.total > 0
        && request.resource.data.total <= 100000000
        && request.resource.data.phone is string
        && request.resource.data.address is string;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['PENDING','CONFIRMED','DELIVERING','COMPLETED','CANCELLED'];
      allow delete: if false;
    }
  }
}
