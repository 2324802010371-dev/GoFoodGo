rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function imageOk() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    function isAdmin() {
      return signedIn() && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }
    match /avatars/{uid}/{file} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid && imageOk();
      allow update, delete: if false;
    }
    match /foods/{uid}/{file} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid && isAdmin() && imageOk();
      allow update, delete: if false;
    }
  }
}
